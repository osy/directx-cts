; Everything Wine already provides is a loader forwarder; the six entry
; points it lacks are stubbed in rpcrt4.c.
LIBRARY dxrpc4
EXPORTS
    CStdStubBuffer_AddRef = rpcrt4.CStdStubBuffer_AddRef
    CStdStubBuffer_Connect = rpcrt4.CStdStubBuffer_Connect
