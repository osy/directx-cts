    CStdStubBuffer_IsIIDSupported = rpcrt4.CStdStubBuffer_IsIIDSupported
    CStdStubBuffer_QueryInterface = rpcrt4.CStdStubBuffer_QueryInterface
    IUnknown_AddRef_Proxy = rpcrt4.IUnknown_AddRef_Proxy
    IUnknown_QueryInterface_Proxy = rpcrt4.IUnknown_QueryInterface_Proxy
    IUnknown_Release_Proxy = rpcrt4.IUnknown_Release_Proxy
    I_RpcExceptionFilter = rpcrt4.I_RpcExceptionFilter
    Ndr64AsyncClientCall = rpcrt4.Ndr64AsyncClientCall
    Ndr64AsyncServerCallAll = dxcts_Ndr64AsyncServerCallAll
    NdrAsyncServerCall = rpcrt4.NdrAsyncServerCall
    NdrCStdStubBuffer_Release = rpcrt4.NdrCStdStubBuffer_Release
    NdrClientCall3 = rpcrt4.NdrClientCall3
    NdrDllGetClassObject = rpcrt4.NdrDllGetClassObject
